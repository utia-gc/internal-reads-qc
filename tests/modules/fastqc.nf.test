nextflow_process {

    name "Test Process fastqc"
    script "modules/fastqc.nf"
    process "fastqc"

    test("fastqc runs QC on a single file batch.") {

        when {
            process {
                """
                input[0] = [
                    file("${projectDir}/tests/data/reads/raw/SRR1066657_S3_L001_R1_001.fastq.gz")
                ]
                """
            }
        }

        then {
            assert process.success

            with(process.out.html) {
                assert size() == 1
                with(get(0)) {
                    assert size() == 1
                    assert get(0) ==~ /^.*\/SRR1066657_S3_L001_R1_001_fastqc.html/

                }
            }
            with(process.out.zip) {
                assert size() == 1
                with(get(0)) {
                    assert size() == 1
                    assert get(0) ==~ /^.*\/SRR1066657_S3_L001_R1_001_fastqc.zip/
                }
            }
        }

    }


    test("fastqc runs QC on a multi-file batch.") {

        when {
            process {
                """
                input[0] = [
                    file("${projectDir}/tests/data/reads/raw/SRR1066657_S3_L002_R1_001.fastq.gz"),
                    file("${projectDir}/tests/data/reads/raw/SRR6924569_S1_L001_R1_001.fastq.gz"),
                    file("${projectDir}/tests/data/reads/raw/SRR6924569_S1_L001_R2_001.fastq.gz"),
                    file("${projectDir}/tests/data/reads/raw/SRR6924569_S1_L002_R1_001.fastq.gz"),
                    file("${projectDir}/tests/data/reads/raw/SRR6924569_S1_L002_R2_001.fastq.gz"),
                ]
                """
            }
        }

        then {
            assert process.success

            with(process.out.html) {
                assert size() == 1
                with(get(0)) {
                    assert size() == 5
                    assert get(0) ==~ /^.*\/SRR1066657_S3_L002_R1_001_fastqc.html/
                    assert get(1) ==~ /^.*\/SRR6924569_S1_L001_R1_001_fastqc.html/
                    assert get(2) ==~ /^.*\/SRR6924569_S1_L001_R2_001_fastqc.html/
                    assert get(3) ==~ /^.*\/SRR6924569_S1_L002_R1_001_fastqc.html/
                    assert get(4) ==~ /^.*\/SRR6924569_S1_L002_R2_001_fastqc.html/
                }
            }
            with(process.out.zip) {
                assert size() == 1
                with(get(0)) {
                    assert size() == 5
                    assert get(0) ==~ /^.*\/SRR1066657_S3_L002_R1_001_fastqc.zip/
                    assert get(1) ==~ /^.*\/SRR6924569_S1_L001_R1_001_fastqc.zip/
                    assert get(2) ==~ /^.*\/SRR6924569_S1_L001_R2_001_fastqc.zip/
                    assert get(3) ==~ /^.*\/SRR6924569_S1_L002_R1_001_fastqc.zip/
                    assert get(4) ==~ /^.*\/SRR6924569_S1_L002_R2_001_fastqc.zip/
                }
            }
        }
    }
}
