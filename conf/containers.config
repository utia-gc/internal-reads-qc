process {
    withLabel: 'base' {
        container = 'biocontainers/biocontainers:v1.2.0_cv2'
    }

    withLabel: 'fastqc' {
        container = 'https://depot.galaxyproject.org/singularity/fastqc%3A0.12.1--hdfd78af_0'
    }

    withLabel: 'fastqc_summary' {
        container = "oras://ghcr.io/utia-gc/fastqc-summary:v2.1.0"
    }

    withLabel: 'multiqc' {
        container = 'https://depot.galaxyproject.org/singularity/multiqc%3A1.21--pyhdfd78af_0'
    }
}
