profiles {
    nf_test {
        params {
            projectName = 'internal-reads-qc_nf-test'
            samplesheet = 'tests/data/samplesheets/all-reads.csv'

            // max resources
            maxCpus   = 2
            maxMemory = '4.GB'
            maxTime   = '15.m'
        }
        
        singularity {
            enabled    = true
            cacheDir   = "${SCRATCHDIR}/singularity"
            autoMounts = true
        }
    }
}
